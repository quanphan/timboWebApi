# Local API port. The current server listens on 5050.
PORT=5050

# development, test, or production.
NODE_ENV=development

# MongoDB connection string. Do not commit a real username, password, or host.
# Local MongoDB:
#   MONGO_URI=mongodb://127.0.0.1:27017
# Production (set the real value in the host secret store, not in git):
#   MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.net
# The database name is selected separately from the URI path.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=timbowebdata

# Long random strings. Do not commit real values.
JWT_SECRET=
REFRESH_SECRET=

# Access token lifetime accepted by jsonwebtoken, and refresh token lifetime in milliseconds.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_MS=604800000

# Comma-separated extra browser origins. Do not use *.
# These PhanQuan origins are always allowed as well:
# https://phanquanguitars.com,https://www.phanquanguitars.com,https://phanquan-guitars.netlify.app
# Keep every origin already present in this value.
CORS_ORIGIN=http://localhost:5173

# Set to true when the API runs behind a reverse proxy.
# Railway sets this automatically. Set false only to force it off.
TRUST_PROXY=false

# Absolute directory for all uploaded files. Default: <api-root>/uploads
# Page-content images are stored in <UPLOADS_DIR>/pages and served as /uploads/pages/<file>.
# Catalog/product images use <UPLOADS_DIR>/guitars and <UPLOADS_DIR>/categories.
# On Railway, create a Volume and mount it at /data/uploads, then set:
#   UPLOADS_DIR=/data/uploads
# Without that mount AND variable, uploaded files are lost on redeploy. MongoDB keeps only the path.
# This repository does not create the Railway volume; confirm it in the Railway dashboard.
# UPLOADS_DIR=/data/uploads
# Optional override for gallery files only. Default: <UPLOADS_DIR>/gallery
# GALLERY_UPLOAD_DIR=/data/uploads/gallery
# GALLERY_IMAGE_MAX_BYTES=8388608
# GALLERY_VIDEO_MAX_BYTES=52428800

# Used only by `npm run seed:superadmin`. The username is always phanquan.
# Rerunning the seed does not reset an existing password. Do not commit a real password.
ADMIN_INITIAL_PASSWORD=
# Optional. Defaults to phanquan@users.local when empty.
ADMIN_INITIAL_EMAIL=

# Google ID token audience. Leave empty to disable Google login.
# A verified Google profile never grants admin or superadmin by itself.
GOOGLE_CLIENT_ID=

# Admin email notifications through Resend. Leave all three empty to disable sending.
# Do not commit a real API key or mailbox.
# In Resend, verify the domain used by EMAIL_FROM before production mail can be delivered.
RESEND_API_KEY=
NOTIFICATION_EMAIL=phanquanpc@gmail.com
EMAIL_FROM=PhanQuan Guitars <notify@phanquanguitars.com>
# API origin for reference-image links. No path, query, or trailing slash.
# Local: PUBLIC_BASE_URL=http://127.0.0.1:5050
# PUBLIC_BASE_URL=https://timbowebapi.up.railway.app
# Frontend origin for admin page links in notification emails.
# Local: FRONTEND_BASE_URL=http://127.0.0.1:5173
# Production uses https://phanquanguitars.com when this is empty.
# FRONTEND_BASE_URL=https://phanquanguitars.com
