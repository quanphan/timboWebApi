# Local API port. The current server listens on 5050.
PORT=5050

# development, test, or production.
NODE_ENV=development

# MongoDB connection string. Do not commit a real username, password, or host.
# Local MongoDB:
#   MONGO_URI=mongodb://127.0.0.1:27017
# Production (set the real value in the host secret store, not in git):
#   MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.net
# The database name is selected separately from the URI path.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=timbowebdata

# Long random strings. Do not commit real values.
JWT_SECRET=
REFRESH_SECRET=

# Access token lifetime accepted by jsonwebtoken, and refresh token lifetime in milliseconds.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_MS=604800000

# Comma-separated extra browser origins. Do not use *.
# https://phanquan-guitars.netlify.app is always allowed in addition to this list.
# Keep every current origin, including the TimboCraft frontend. Do not replace the list with only the Netlify origin.
# Example: CORS_ORIGIN=https://timbocraft.example,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Set to true when the API runs behind a reverse proxy.
# Railway sets this automatically. Set false only to force it off.
TRUST_PROXY=false

# Absolute directory for all uploaded files. Default: <api-root>/uploads
# On Railway, mount a persistent volume here or gallery/catalog images are lost on redeploy.
# UPLOADS_DIR=/data/uploads
# Optional override for gallery files only. Default: <UPLOADS_DIR>/gallery
# GALLERY_UPLOAD_DIR=/data/uploads/gallery
# GALLERY_IMAGE_MAX_BYTES=8388608
# GALLERY_VIDEO_MAX_BYTES=52428800

# Used only by `npm run seed:superadmin`. The username is always phanquan.
# Rerunning the seed does not reset an existing password. Do not commit a real password.
ADMIN_INITIAL_PASSWORD=
# Optional. Defaults to phanquan@users.local when empty.
ADMIN_INITIAL_EMAIL=

# Google ID token audience. Leave empty to disable Google login.
# A verified Google profile never grants admin or superadmin by itself.
GOOGLE_CLIENT_ID=
